{
  "description": "agentic-software-development: refuse a tool call that repeats itself in a row (scripts/hooks/repeat_guard.py), and a sub-agent spawn the auto mode classifier cannot judge (scripts/hooks/spawn_guard.py), and the shared context mirror under bun: a read guard (shared/claude/pre-tool-use.ts), a checkpoint reminder (post-tool-use.ts) and the restore of phase_checkpoint records after a compaction (session-start.ts), a step line before each test, gate, PR and agent wave for the owner's timeline (step.ts), the hard block of the owner's agent sessions, active only when ASD_AGENT_SURFACE or ASD_HARD_BLOCK=1 is set (shared/claude/hard-block.ts), and a record of every call auto mode refuses, for the dashboard's Blocked card (permission-denied.ts)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/repeat_guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/spawn_guard.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 && bun \"${CLAUDE_PLUGIN_ROOT}/shared/claude/pre-tool-use.ts\" || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 && bun \"${CLAUDE_PLUGIN_ROOT}/shared/claude/hard-block.ts\" || true",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|Workflow|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 && bun \"${CLAUDE_PLUGIN_ROOT}/shared/claude/step.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 && bun \"${CLAUDE_PLUGIN_ROOT}/shared/claude/post-tool-use.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 && bun \"${CLAUDE_PLUGIN_ROOT}/shared/claude/session-start.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 && bun \"${CLAUDE_PLUGIN_ROOT}/shared/claude/subagent-stop.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v bun >/dev/null 2>&1 && bun \"${CLAUDE_PLUGIN_ROOT}/shared/claude/permission-denied.ts\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
