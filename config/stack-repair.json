{
  "repos": {
    "config-harness": {
      "vm": "nightwatch",
      "compose_dir": "deploy/compose",
      "vm_start": [
        "limactl",
        "start",
        "{vm}"
      ],
      "stack_up": [
        "bash",
        "-lc",
        "cd {root} && bash deploy/host/host.sh exec -- deploy/scripts/up.sh test"
      ],
      "env_script": "deploy/host/test-env.sh",
      "env_catalog": {
        "file": "deploy/secrets-catalog.json",
        "key": "bootstrap",
        "field": "variable"
      },
      "lease_probe": [
        "limactl",
        "shell",
        "{vm}",
        "--",
        "bash",
        "-lc",
        "d=/tmp; [ -n \"$TMPDIR\" ] && d=$TMPDIR; f=$d/nightwatch-locks/stack-suite.lease; [ -e \"$f\" ] || exit 0; flock -n \"$f\" true"
      ],
      "fixture_stamp": [
        "limactl",
        "shell",
        "{vm}",
        "--",
        "bash",
        "-lc",
        "cd {stamp_dir} && bash deploy/fake-llm/source_stamp.sh"
      ],
      "fixture_probe": [
        "limactl",
        "shell",
        "{vm}",
        "--",
        "bash",
        "-lc",
        "cd {root} && bash deploy/fake-llm/stamp_probe.sh http://127.0.0.1:8089/_stamp"
      ],
      "fixture_rebuild": [
        "limactl",
        "shell",
        "{vm}",
        "--",
        "bash",
        "-lc",
        "d=/tmp; [ -n \"$TMPDIR\" ] && d=$TMPDIR; mkdir -p \"$d/nightwatch-locks\"; exec flock -E 75 -n \"$d/nightwatch-locks/stack-suite.lease\" bash -c 'cd {root}/{compose_dir} && docker compose build fake-llm && docker compose up -d --no-deps fake-llm'"
      ],
      "skip_env": {
        "NIGHTWATCH_DB_TESTS": "skip",
        "NIGHTWATCH_NATS_TESTS": "skip",
        "NIGHTWATCH_PROXY_TESTS": "skip",
        "NIGHTWATCH_COLLECTOR_TESTS": "skip",
        "NIGHTWATCH_GCP_TESTS": "skip"
      },
      "suite_markers": [
        "--stack"
      ],
      "stack_state_files": [
        "deploy/compose/nats/opmode/"
      ],
      "stack_env_regen": {
        "command": [
          "bash",
          "-lc",
          "cd {root} && bash deploy/host/host.sh exec -- deploy/scripts/up.sh --env-only"
        ],
        "path": ".runtime.env",
        "source": "deploy/secrets/bootstrap.enc.env"
      },
      "leftover_projects": [
        {
          "name": "nightwatch-w108",
          "handoff": true,
          "handoff_up": [
            "limactl",
            "shell",
            "{vm}",
            "--",
            "bash",
            "-lc",
            "cd {root} && bash deploy/host/opmode-stack.sh up"
          ],
          "owner_probe": [
            "limactl",
            "shell",
            "{vm}",
            "--",
            "bash",
            "-lc",
            "l=$(docker inspect -f '{{index .Config.Labels \"com.docker.compose.project.working_dir\"}}' $(docker ps -aq --filter label=com.docker.compose.project=nightwatch-w108 | head -n 1) 2>/dev/null); printf '%s\\n' \"${l%/deploy/compose}\"; true"
          ],
          "window_probe": [
            "limactl",
            "shell",
            "{vm}",
            "--",
            "bash",
            "-lc",
            "d=/tmp; [ -n \"$TMPDIR\" ] && d=$TMPDIR; f=$d/nightwatch-locks/stack-suite.window; [ -s \"$f\" ] && head -n 2 \"$f\"; true"
          ],
          "pid_probe": [
            "limactl",
            "shell",
            "{vm}",
            "--",
            "bash",
            "-lc",
            "ps -p {pid} >/dev/null 2>&1"
          ],
          "down": [
            "limactl",
            "shell",
            "{vm}",
            "--",
            "bash",
            "-lc",
            "cd {root} && bash deploy/host/opmode-stack.sh down"
          ]
        }
      ]
    }
  }
}
