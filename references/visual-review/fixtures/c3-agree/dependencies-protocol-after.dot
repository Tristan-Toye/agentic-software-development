digraph {

    graph [
        label="protocol",
        labelloc=t,

        pad=0.4,

        // Consider rendering the graph using a different layout algorithm, such as:
        // [dot, neato, twopi, circo, fdp, sfdp]
        layout=neato,
        overlap=false,
        splines="line",
        rankdir=LR,

        fontname="Helvetica", 
        fontsize="36",
    ];

    node [
        fontname="monospace",
        fontsize="10",
        shape="record",
        style="filled",
    ];

    edge [
        fontname="monospace",
        fontsize="10",
    ];

    "protocol" [label="crate|protocol", fillcolor="#5397c8"]; // "crate" node
    "protocol::envelope" [label="pub mod|envelope", fillcolor="#81c169"]; // "mod" node
    "protocol::identity" [label="pub mod|identity", fillcolor="#81c169"]; // "mod" node
    "protocol::ops" [label="pub mod|ops", fillcolor="#81c169"]; // "mod" node
    "protocol::ports::artifact_store" [label="pub mod|ports::artifact_store", fillcolor="#81c169"]; // "mod" node
    "protocol::ports::client_secrets" [label="pub mod|ports::client_secrets", fillcolor="#81c169"]; // "mod" node
    "protocol::ports::cloud" [label="pub mod|ports::cloud", fillcolor="#81c169"]; // "mod" node
    "protocol::ports::git_host" [label="pub mod|ports::git_host", fillcolor="#81c169"]; // "mod" node
    "protocol::ports::llm" [label="pub mod|ports::llm", fillcolor="#81c169"]; // "mod" node
    "protocol::ports::parameters" [label="pub mod|ports::parameters", fillcolor="#81c169"]; // "mod" node
    "protocol::ports::secrets" [label="pub mod|ports::secrets", fillcolor="#81c169"]; // "mod" node
    "protocol::provision" [label="pub mod|provision", fillcolor="#81c169"]; // "mod" node
    "protocol::repo_grant" [label="pub mod|repo_grant", fillcolor="#81c169"]; // "mod" node
    "protocol::sandbox_tool" [label="pub mod|sandbox_tool", fillcolor="#81c169"]; // "mod" node
    "protocol::schema" [label="pub mod|schema", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::annotation" [label="pub mod|schema::annotation", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::artifact" [label="pub mod|schema::artifact", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::effects" [label="pub mod|schema::effects", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::enums" [label="pub mod|schema::enums", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::fingerprint" [label="pub mod|schema::fingerprint", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::ids" [label="pub mod|schema::ids", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::insights" [label="pub mod|schema::insights", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::invariants" [label="pub mod|schema::invariants", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::ledger" [label="pub mod|schema::ledger", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::mirror_maintenance" [label="pub mod|schema::mirror_maintenance", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::node" [label="pub mod|schema::node", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::provenance" [label="pub mod|schema::provenance", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::secrets" [label="pub mod|schema::secrets", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::settings" [label="pub mod|schema::settings", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::tool_policy" [label="pub mod|schema::tool_policy", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::track" [label="pub mod|schema::track", fillcolor="#81c169"]; // "mod" node
    "protocol::schema::trigger" [label="pub mod|schema::trigger", fillcolor="#81c169"]; // "mod" node
