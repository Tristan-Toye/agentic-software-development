digraph {

    graph [
        label="platform",
        labelloc=t,

        pad=0.4,

        // Consider rendering the graph using a different layout algorithm, such as:
        // [dot, neato, twopi, circo, fdp, sfdp]
        layout=neato,
        overlap=false,
        splines="line",
        rankdir=LR,

        fontname="Helvetica", 
        fontsize="36",
    ];

    node [
        fontname="monospace",
        fontsize="10",
        shape="record",
        style="filled",
    ];

    edge [
        fontname="monospace",
        fontsize="10",
    ];

    "platform" [label="crate|platform", fillcolor="#5397c8"]; // "crate" node
    "platform::artifact_fs" [label="pub mod|artifact_fs", fillcolor="#81c169"]; // "mod" node
    "platform::client_secrets_admin" [label="pub mod|client_secrets_admin", fillcolor="#81c169"]; // "mod" node
